# =============================================================================
# DC-Ops AMD training — environment template
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. The launch scripts
# (launch/sft.sh and launch/grpo.sh) will auto-`source` it before starting
# training. Never commit the real `.env` — `.gitignore` already excludes it.
# =============================================================================

# ----- HuggingFace ---------------------------------------------------------
# Required if:
#   - you push the SFT adapter with scripts/push_to_hf.py, or
#   - you load the SFT adapter from a PRIVATE HF repo in GRPO.
# Get a token at https://huggingface.co/settings/tokens (needs "write" scope
# for pushing, "read" is enough for just loading).
HUGGINGFACE_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ----- Weights & Biases ----------------------------------------------------
# Required if wandb.enabled=true in configs/{sft,grpo}.yaml (which is the
# default). Get a key at https://wandb.ai/authorize
WANDB_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: override where wandb stores artifacts locally
# WANDB_DIR=/path/to/big/scratch/disk/wandb

# ----- Optional: override which GPU to use ---------------------------------
# Single-GPU by default — set this if your node has more than one MI300X
# and you want to pick a specific one.
# HIP_VISIBLE_DEVICES=0

# ----- Optional: HF cache location -----------------------------------------
# Point this at your 5 TB scratch disk if /home is small. Model downloads
# go here — the Qwen2.5-7B base is ~15 GB, SFT LoRA is tiny.
# HF_HOME=/scratch/hf-cache
